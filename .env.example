# ───────────────────────────────────────────────────────────────
# agicare — variáveis de ambiente (copie para .env.local e preencha)
# ───────────────────────────────────────────────────────────────

# ── Banco (MySQL 8.0.16+ ou MariaDB 10.4+) ─────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agicare
MYSQL_PASSWORD=
MYSQL_DATABASE=agicare

# TLS na conexão com o banco. Obrigatório quando o banco está em outra
# máquina ou é gerenciado. Deixe vazio se o banco é local (127.0.0.1).
#   1            → exige TLS e valida o certificado (recomendado)
#   skip-verify  → exige TLS mas aceita certificado autoassinado
MYSQL_SSL=

# Opcionais
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT_MS=10000

# ── Sessão ─────────────────────────────────────────────────────
# Assina o cookie de sessão (substitui o JWT do Supabase Auth).
# OBRIGATÓRIO fora de desenvolvimento — o app não sobe sem ele.
# Mínimo 32 caracteres. Trocar o valor derruba todas as sessões abertas.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Minutos de inatividade até expirar a sessão (padrão 120). O valor de
# clinic_settings.security.sessionTimeoutMin tem precedência sobre este.
SESSION_IDLE_MINUTES=120

# ── Arquivos (substitui o Supabase Storage) ────────────────────
# Precisa ser um diretório PERSISTENTE e gravável pelo usuário do processo.
# Não fica em public/: os arquivos só saem por rota autenticada.
STORAGE_DIR=./storage

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NÃO defina NODE_ENV aqui.
# O `next dev` já usa development e o `next build`/`next start` usam
# production. Fixar o valor num .env faz o servidor de produção rodar em
# modo de desenvolvimento — e aí o cookie de sessão perde o `secure` e a
# exigência do AUTH_SECRET é desligada.

# ── Cron (rota /api/cron/check-no-shows) ───────────────────────
# Em produção a rota só responde com: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Integrações (opcionais; sem chave, ficam desligadas) ───────
RESEND_API_KEY=
NOTIFICATIONS_EMAIL_FROM=
SMS_API_KEY=
WHATSAPP_API_KEY=
PAYMENT_GATEWAY=
